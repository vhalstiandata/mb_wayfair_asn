# Copy to .env and fill in your values for local development.
# In Cloud Run these are populated automatically from Secret Manager + env vars.

# ── Runtime flags ───────────────────────────────────────────────
ENVIRONMENT=sandbox
DRY_RUN=false
LOOKBACK_DAYS=3
ONLY_NEW_POS=false
CLIENT_SIDE_DATE_FILTER=true
FORCE_CARRIER=FEDEX

# ── NetSuite ────────────────────────────────────────────────────
NETSUITE_REALM=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN=
NETSUITE_TOKEN_SECRET=

NETSUITE_INVENTORY_SCRIPT=1386
NETSUITE_INVENTORY_DEPLOY=2
NETSUITE_WAYFAIR_CUSTOMER_ID=18
NETSUITE_SUBSIDIARY_ID=2
NETSUITE_DEFAULT_LOCATION_ID=8
EXCLUDED_LOCATIONS=15,20

WAYFAIR_NET_FACTOR=0.83
DISCOUNT_ITEM_ID=10463
RETAIL_PRICELEVEL_ID=1

# ── Wayfair ─────────────────────────────────────────────────────
WAYFAIR_CLIENT_ID=
WAYFAIR_CLIENT_SECRET=
WAYFAIR_SUPPLIER_ID=267342

# ── Source warehouse address (real address before going live) ───
SOURCE_ADDR_NAME=Maestro Bath Warehouse
SOURCE_ADDR_STREET1=123 Warehouse Street
SOURCE_ADDR_STREET2=
SOURCE_ADDR_CITY=Los Angeles
SOURCE_ADDR_STATE=CA
SOURCE_ADDR_POSTAL=90001
SOURCE_ADDR_COUNTRY=US

# ── BigQuery ────────────────────────────────────────────────────
BQ_PROJECT_ID=maestrobath
BQ_DATASET=wayfair_inventory

# For local runs only — Cloud Run uses Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
